up:
  #!/usr/bin/env bash
  set -x
  docker compose --project-directory docker up -d
  supervisord

spin:
  #!/usr/bin/env bash
  set -x
  cabal build kontrakcja-server && \
    truncate -s0 logs/kontrakcja-server.log && \
    supervisorctl restart programs:

down:
  #!/usr/bin/env bash
  set -x
  supervisorctl stop all
  supervisorctl shutdown
  docker compose --project-directory docker down
  pgrep -a slack || true

# Run the frontend test suite on headless Chromium.
# `test:fast` runs karma only. `test` adds eslint and coverage.
test-frontend task="test:fast":
  #!/usr/bin/env bash
  set -euo pipefail
  chrome=$(command -v chromium || command -v google-chrome-stable) || {
    echo "No chromium on PATH. karma-chrome-launcher needs CHROME_BIN." >&2
    exit 1
  }
  cd frontend
  CHROME_BIN=${chrome} NODE_OPTIONS=--openssl-legacy-provider \
    node_modules/.bin/grunt {{task}}

# List local bookmarks that are not pushed remotely.
local-bookmarks:
  #!/usr/bin/env bash
  set -x
  jj log -r 'bookmarks() & ~(master | remote_bookmarks())'

# Generate git hook to automatically prepare the commit message.
git-hooks:
  #!/usr/bin/env bash

  cat <<"EOF" > .git/hooks/prepare-commit-msg
  #!/usr/bin/env bash

  commit_msg_file=$1

  branch=$(jj workspace root)

  if [[ "${branch}" =~ ^.*core-?([0-9]+).* ]]; then
    prefix="CORE-${BASH_REMATCH[1]}"
  elif [[ "${branch}" =~ ^.*no-?issue.* ]]; then
    prefix="NO-ISSUE"
  fi

  current_msg=$(head -n 1 "${commit_msg_file}")

  if [ -n "$prefix" ] && (echo "${current_msg}" | grep -vi "^\[${prefix}\]") && \
    (echo "${current_msg}" | grep -vi "fixup\|squash")
  then
    sed -i.bak -e "1s/^/[$prefix] \n/" "${commit_msg_file}"
  fi
  EOF

  chmod +x .git/hooks/prepare-commit-msg

posting:
  posting --collection posting

# ECR image tag(s) Cerberus pushed for a commit (default: the current bookmark).
# Requires the commit to be pushed and, on a PR, the `deploy` label.
image-tags sha=`jj log -r 'latest(::@ & bookmarks())' --no-graph -T commit_id`:
  #!/usr/bin/env bash
  set -euo pipefail
  repo=scrive/kontrakcja
  check_ids=$(gh api "repos/${repo}/commits/{{sha}}/check-runs" \
    --jq '.check_runs[] | select(.name | test("preamble"; "i")) | .id')
  if [[ -z ${check_ids} ]]; then
    echo "No Cerberus run for {{sha}}." >&2
    echo "Push it, then re-apply the PR's 'deploy' label to trigger one." >&2
    exit 1
  fi
  for id in ${check_ids}; do
    gh api "repos/${repo}/check-runs/${id}/annotations" --jq '.[].message'
  done | grep -oE '[^ ,]+/kontrakcja:[^ ,]+' | sort -u \
    || { echo "Cerberus ran but pushed no image; prepare-dist-image was skipped." >&2; exit 1; }

# The `pr-` tag to pin as `newTag` in k8s-deployments (`dist-` names a merge commit).
deploy-tag *sha:
  @{{just_executable()}} image-tags {{sha}} | grep -oE 'pr-[0-9]+-[0-9a-f]{40}'
